# CMake/C++ build output. Everything here is regenerated by a configure+build
# and none of it is source.
build/
build-*/
cmake-build-*/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
Testing/
_deps/
install_manifest.txt
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk

# Conformance runs write actual/diff output beside the expected fixtures.
# expected.json and case.json are source and stay tracked.
tests/conformance/**/actual.json
tests/conformance/**/diff.png
tests/conformance/**/*.actual.*

# Local run/deploy overrides
ops/*.local.*
*.local.env

# Cygwin/Git-Bash crash dumps (created anywhere a bash tool crashes).
bash.exe.stackdump
**/bash.exe.stackdump

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
