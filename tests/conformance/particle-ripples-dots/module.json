 "scene": [
  {
   "effectSources": [
    {
     "anticipation": {
      "$expr": "settings.anticipation",
      "code": [
       {
        "key": "settings.anticipation",
        "op": "load"
       }
      ]
     },
     "attack": {
      "$expr": "settings.ramp_up",
      "code": [
       {
        "key": "settings.ramp_up",
        "op": "load"
       }
      ]
     },
     "channel": "energy",
     "duration": 6,
     "falloff": 0.965,
     "flashPower": {
      "$expr": "settings.flash_power",
      "code": [
       {
        "key": "settings.flash_power",
        "op": "load"
       }
      ]
     },
     "id": "beat-ripple",
     "kind": "wave",
     "propagation": "radial",
     "release": {
      "$expr": "settings.release",
      "code": [
       {
        "key": "settings.release",
        "op": "load"
       }
      ]
     },
     "shape": "circle",
     "speed": 0.36,
     "steepness": 0.9,
     "strength": {
      "$expr": "settings.intensity * (0.45 + audio.bass * 0.55) * mix(1, settings.strong_beat_multiplier, smoothstep(0.55, 1, audio.bass))",
      "code": [
       {
        "key": "settings.intensity",
        "op": "load"
       },
       {
        "op": "const",
        "value": 0.45
       },
       {
        "key": "audio.bass",
        "op": "load"
       },
       {
        "op": "const",
        "value": 0.55
       },
       {
        "op": "mul"
       },
       {
        "op": "add"
       },
       {
        "op": "mul"
       },
       {
        "op": "const",
        "value": 1
       },
       {
        "key": "settings.strong_beat_multiplier",
        "op": "load"
       },
       {
        "op": "const",
        "value": 0.55
       },
       {
        "op": "const",
        "value": 1
       },
       {
        "key": "audio.bass",
        "op": "load"
       },
       {
        "argc": 3,
        "fn": "smoothstep",
        "op": "call"
       },
       {
        "argc": 3,
        "fn": "mix",
        "op": "call"
       },
       {
        "op": "mul"
       }
      ]
     },
     "trigger": "beat",
     "waveform": "gerstner",
     "wavelength": 0.095238
    }
   ],
