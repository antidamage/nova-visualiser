   "id": "peak_glow",
   "label": "Peak glow",
   "max": 12,
   "min": 1,
   "options": [],
   "section": "physics",
   "step": 0.25,
   "updateMode": "smooth"
  },
  {
   "affects": [
    "templates.particle.render.flareThreshold"
   ],
   "control": "slider",
   "curve": {
    "exponent": 1.5,
    "type": "power"
   },
   "default": 0.28,
   "description": "Wave energy at which the HDR flare begins to bloom.",
   "id": "peak_threshold",
   "label": "Peak threshold",
   "max": 0.8,
   "min": 0.1,
   "options": [],
   "section": "physics",
   "step": 0.01,
   "updateMode": "smooth"
  },
  {
   "affects": [
    "scene.particle-grid.effectSources.beat-ripple.attack"
   ],
   "control": "slider",
   "curve": {
    "exponent": 2.2,
    "type": "power"
   },
   "default": 0.04,
   "description": "Time taken for rising wave energy to reach the flash.",
   "id": "ramp_up",
   "label": "Flash ramp up",
   "max": 0.2,
   "min": 0.015,
   "options": [],
   "section": "physics",
   "step": 0.005,
   "updateMode": "smooth"
  },
  {
   "affects": [
    "scene.particle-grid.effectSources.beat-ripple.release"
   ],
   "control": "slider",
   "curve": {
    "exponent": 1.6,
    "type": "power"
   },
   "default": 0.7,
   "description": "Time for the crest glow to ease back into the dot.",
   "id": "release",
   "label": "Glow release",
   "max": 1.5,
   "min": 0.15,
   "options": [],
   "section": "physics",
   "step": 0.05,
   "updateMode": "smooth"
  },
  {
   "affects": [
    "scene.particle-grid.effectSources.beat-ripple.strength"
   ],
   "control": "slider",
   "curve": {
    "exponent": 1.6,
    "type": "power"
   },
   "default": 1.65,
   "description": "Extra wave energy applied only as bass strength enters its upper range.",
   "id": "strong_beat_multiplier",
   "label": "Strong beat multiplier",
   "max": 3,
   "min": 1,
   "options": [],
   "section": "physics",
   "step": 0.05,
   "updateMode": "smooth"
  },
  {
   "affects": [
    "templates.particle.render.trailLength"
   ],
   "control": "slider",
   "curve": {
    "exponent": 1.4,
    "type": "power"
   },
   "default": 7,
   "description": "Length of the tapered wake behind particles that cross the glow threshold, in particle radii. Zero disables trails.",
   "id": "trail_length",
   "label": "Trail length",
   "max": 500,
   "min": 0,
   "options": [],
   "section": "physics",
   "step": 0.5,
   "updateMode": "smooth"
  }
 ],
