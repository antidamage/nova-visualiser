   "max": 1,
   "min": 0,
   "options": [],
   "section": "physics",
   "step": 1,
   "updateMode": "smooth"
  },
  {
   "affects": [
    "scene.particle-grid.effectSources.beat-ripple.strength"
   ],
   "control": "slider",
   "curve": {
    "exponent": 1,
    "type": "linear"
   },
   "default": 1,
   "description": "Base energy carried by every beat wave.",
