   "label": "Ripple intensity",
   "max": 2,
   "min": 0,
   "options": [],
   "section": "physics",
   "step": 0.05,
   "updateMode": "smooth"
  },
  {
   "affects": [
    "scene.particle-grid.effectSources.beat-ripple.offsetMagnifier"
