   "id": "dot_size",
   "label": "Dot size",
   "max": 50,
   "min": 0,
   "options": [],
   "section": "motion",
   "step": 0.1,
   "updateMode": "smooth"
  },
  {
   "affects": [
    "scene.particle-grid.effectSources.beat-ripple.flashPower"
   ],
   "control": "slider",
   "curve": {
    "exponent": 1.5,
    "type": "power"
   },
   "default": 3.8,
   "description": "Shapes how sharply the leading-edge glow concentrates into its crest.",
   "id": "flash_power",
   "label": "Flash power",
   "max": 8,
   "min": 1.5,
   "options": [],
   "section": "physics",
   "step": 0.1,
   "updateMode": "smooth"
  },
  {
   "affects": [
    "renderer.fluidBackground.speed"
   ],
   "control": "slider",
   "curve": {
    "exponent": 1,
    "type": "linear"
   },
   "default": 0.65,
