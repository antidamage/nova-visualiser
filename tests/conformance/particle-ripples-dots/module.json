   "label": "Fluid background speed",
   "max": 1.5,
   "min": 0.25,
   "options": [],
   "section": "physics",
   "step": 0.05,
   "updateMode": "smooth"
  },
  {
   "affects": [
    "scene.particle-grid.field.extentY"
   ],
   "control": "slider",
   "default": 0.3333,
   "description": "Height of the particle lattice as a share of the frame. The gap between dots comes from Visual complexity, so a taller grid means more rows, not looser spacing.",
   "id": "grid_height",
   "label": "Grid height",
   "max": 1,
   "min": 0,
   "options": [],
   "section": "physics",
   "step": 0.01
  },
  {
   "affects": [
    "scene.particle-grid.field.extentX"
   ],
   "control": "slider",
   "default": 1,
   "description": "Width of the particle lattice as a share of the frame. The gap between dots comes from Visual complexity, so a wider grid means more columns, not wider spacing.",
   "id": "grid_width",
   "label": "Grid width",
   "max": 1,
   "min": 0,
   "options": [],
   "section": "physics",
   "step": 0.01
  },
  {
   "affects": [
    "scene.particle-grid.field.wireframe"
