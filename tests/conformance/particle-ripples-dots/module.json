 "settings": [
  {
   "affects": [
    "scene.particle-grid.effectSources.beat-ripple.anticipation"
   ],
   "control": "slider",
   "curve": {
    "exponent": 1,
    "type": "linear"
   },
   "default": 0.5,
   "description": "How early the leading edge starts to illuminate before the crest arrives.",
   "id": "anticipation",
   "label": "Glow anticipation",
   "max": 0.9,
   "min": 0.12,
   "options": [],
   "section": "physics",
   "step": 0.01,
   "updateMode": "smooth"
  },
  {
   "affects": [
    "scene.particle-grid.field.density"
   ],
   "control": "slider",
   "curve": {
    "exponent": 1.5,
    "type": "power"
   },
   "default": 0.6,
   "description": "Grid density. Lower settings reduce both ripple simulation and draw count while preserving the full-screen field.",
   "id": "complexity",
   "label": "Visual complexity",
   "max": 1,
   "min": 0.2,
   "options": [],
   "section": "physics",
   "step": 0.05,
   "updateMode": "structural"
  },
  {
   "affects": [
    "templates.particle.render.dotSizePixels"
   ],
   "control": "slider",
   "curve": {
    "exponent": 1,
    "type": "linear"
   },
   "default": 3.8,
