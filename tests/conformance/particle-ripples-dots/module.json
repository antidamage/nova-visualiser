      {
       "key": "palette.lineSecondary",
       "op": "load"
      }
     ]
    },
    "wireframeColorStart": {
     "$expr": "palette.linePrimary",
     "code": [
      {
       "key": "palette.linePrimary",
       "op": "load"
      }
     ]
    }
   },
   "id": "particle-grid"
  }
