#version 460 core

// Tonemap + RGB -> NV12 (8-bit 4:2:0) for the browser rung.
//
// Separate from the P010 pass on purpose: browsers cannot decode HEVC over
// WebRTC and cannot decode H.264 High 10 at all, so the dashboard and kiosk feed
// has to be 8-bit H.264. It also downscales -- 1080p is plenty for a dashboard
// panel and much kinder to the kiosk's decoder than 4K.
//
// Each invocation owns a 4x2 pixel tile. That is the smallest tile for which
// both planes are written as whole 32-bit words (4 luma bytes per row, and
// 2 chroma pairs), so the pass needs no atomics and no per-frame buffer clear.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D sourceImage;

layout(std430, binding = 1) writeonly buffer LumaPlane { uint luma[]; };
layout(std430, binding = 2) writeonly buffer ChromaPlane { uint chroma[]; };

uniform ivec2 outputSize;
uniform ivec2 strideUints;   // x luma row stride, y chroma row stride
uniform int limitedRange;
uniform float exposure;
uniform int flipY;

vec3 rgbToYuv709(vec3 rgb) {
  float y  = dot(rgb, vec3( 0.2126,  0.7152,  0.0722));
  float cb = dot(rgb, vec3(-0.1146, -0.3854,  0.5000));
  float cr = dot(rgb, vec3( 0.5000, -0.4542, -0.0458));
  return vec3(y, cb + 0.5, cr + 0.5);
}

// Match the direct `bgra8Unorm` write used by the native Apple TV composite.
// Theme RGB is already display-referred; a second tonemap/transfer washes it
// out before the video encoder ever sees it.
vec3 displayColor(vec3 color) {
  return clamp(max(color, vec3(0.0)) * exposure, 0.0, 1.0);
}

float dither(ivec2 position) {
  const float pattern[16] = float[16](
     0.0,  8.0,  2.0, 10.0,
    12.0,  4.0, 14.0,  6.0,
     3.0, 11.0,  1.0,  9.0,
    15.0,  7.0, 13.0,  5.0
  );
  return (pattern[(position.y & 3) * 4 + (position.x & 3)] / 16.0) - 0.5;
}

uint quantise(float value, float low, float high, ivec2 position) {
  float scaled = low + clamp(value, 0.0, 1.0) * (high - low);
  return uint(clamp(scaled * 255.0 + dither(position), 0.0, 255.0) + 0.5);
}

// Sampled in normalised coordinates so the pass doubles as the downscale from
// the 4K render target. At an exact 2:1 ratio linear filtering is a true box.
vec3 sampleScene(ivec2 position) {
  vec2 uv = (vec2(position) + 0.5) / vec2(outputSize);
  if (flipY == 1) uv.y = 1.0 - uv.y;
  return displayColor(texture(sourceImage, uv).rgb);
}

void main() {
  ivec2 tile = ivec2(gl_GlobalInvocationID.xy);
  ivec2 base = ivec2(tile.x * 4, tile.y * 2);
  if (base.x >= outputSize.x || base.y >= outputSize.y) return;

  float lumaLow = limitedRange == 1 ? 16.0 / 255.0 : 0.0;
  float lumaHigh = limitedRange == 1 ? 235.0 / 255.0 : 1.0;
  float chromaLow = limitedRange == 1 ? 16.0 / 255.0 : 0.0;
  float chromaHigh = limitedRange == 1 ? 240.0 / 255.0 : 1.0;

  // Two 2x2 chroma blocks live inside this tile.
  vec3 chromaSum[2] = vec3[2](vec3(0.0), vec3(0.0));
  int chromaSampleCount[2] = int[2](0, 0);

  for (int dy = 0; dy < 2; ++dy) {
    int y = base.y + dy;
    if (y >= outputSize.y) break;
    uint word = 0u;
    for (int dx = 0; dx < 4; ++dx) {
      ivec2 position = ivec2(base.x + dx, y);
      if (position.x >= outputSize.x) continue;
      vec3 yuv = rgbToYuv709(sampleScene(position));
      int chromaHalf = dx >> 1;
      chromaSum[chromaHalf] += yuv;
      ++chromaSampleCount[chromaHalf];
      word |= quantise(yuv.x, lumaLow, lumaHigh, position) << uint(dx * 8);
    }
    luma[uint(y) * uint(strideUints.x) + uint(tile.x)] = word;
  }

  uint chromaWord = 0u;
  for (int chromaHalf = 0; chromaHalf < 2; ++chromaHalf) {
    if (chromaSampleCount[chromaHalf] == 0) continue;
    vec3 averaged = chromaSum[chromaHalf] / float(chromaSampleCount[chromaHalf]);
    ivec2 position = ivec2(base.x + chromaHalf * 2, base.y);
    uint cb = quantise(averaged.y, chromaLow, chromaHigh, position);
    uint cr = quantise(averaged.z, chromaLow, chromaHigh, position + ivec2(1, 0));
    chromaWord |= (cb | (cr << 8)) << uint(chromaHalf * 16);
  }
  chroma[uint(tile.y) * uint(strideUints.y) + uint(tile.x)] = chromaWord;
}
